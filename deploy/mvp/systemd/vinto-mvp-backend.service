[Unit]
Description=VINTO MVP WEB — backend FastAPI (piloto, aislado de TVC)
After=network-online.target
Wants=network-online.target
# StartLimitIntervalSec/StartLimitBurst pertenecen a [Unit], no a [Service] (CLOUD-DEP-02B.1-C.1:
# confirmado con "systemd-analyze verify" contra systemd 255, la misma versión del VPS — puestos
# en [Service] como estaban antes, systemd los ignora silenciosamente ("Unknown key name"), así
# que la política de reinicio controlada de abajo nunca llegaba a aplicarse de verdad).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Usuario de servicio DEDICADO (CLOUD-DEP-02A, Fase 3 §1): nunca "ubuntu" (el que usa TVC).
# Debe crearse como cuenta de sistema sin shell de login, sin contraseña, propietaria
# EXCLUSIVAMENTE de /opt/vinto-mvp-web (ver deploy/mvp/scripts/deploy.sh, paso de creación de usuario).
User=vinto-mvp
Group=vinto-mvp
# "current" es un symlink mantenido por deploy.sh (fase "activate") que apunta a la versión
# desplegada en /opt/vinto-mvp-web/releases/<sha> (CLOUD-DEP-02A.2, DEP55-04: versiones separadas
# para poder revertir). systemd resuelve el symlink al arrancar el servicio.
WorkingDirectory=/opt/vinto-mvp-web/current/backend

# Las credenciales NO se pasan aquí: backend/app/config.py ya lee backend/.env directamente
# (pydantic-settings, env_file=BACKEND_DIR/".env"). Usar "EnvironmentFile=" en su lugar las
# expondría en texto plano vía `systemctl show -p Environment` / journald. backend/.env es en
# realidad un enlace a /opt/vinto-mvp-web/shared/backend.env (600, propietario vinto-mvp:vinto-mvp,
# NUNCA en git — ver deploy/mvp/env/backend.env.example), compartido entre todas las versiones.
ExecStart=/opt/vinto-mvp-web/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100

# Política de reinicio controlada (CLOUD-DEP-02A, Fase 3 §8): reinicia solo ante fallo real,
# nunca en bucle inmediato ni de forma indefinida sin límite.
Restart=on-failure
RestartSec=5

# Límites de CPU/memoria (Fase 3 §7). Ajustar según el tamaño real del piloto; estos valores son
# un punto de partida conservador, no una medición de carga real (no se hizo ningún benchmark).
MemoryMax=512M
CPUQuota=100%
TasksMax=256

# Endurecimiento de proceso — ninguno de estos directivas toca TVC ni ningún otro servicio.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/vinto-mvp-web/current/backend
# El backend nunca necesita escribir fuera de su propio árbol (no genera archivos de datos locales:
# toda la persistencia es PostgreSQL). Si en el futuro necesitara una ruta de logs propia, añadirla
# aquí explícitamente en vez de relajar ProtectSystem.

[Install]
WantedBy=multi-user.target
