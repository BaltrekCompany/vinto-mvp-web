[Unit]
Description=VINTO MVP WEB — frontend (vinext standalone Node.js, piloto, aislado de TVC)
After=network-online.target
Wants=network-online.target
# StartLimitIntervalSec/StartLimitBurst pertenecen a [Unit], no a [Service] (CLOUD-DEP-02B.1-C.1:
# confirmado con "systemd-analyze verify" contra systemd 255, la misma versión del VPS).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vinto-mvp
Group=vinto-mvp
# "current" es un symlink mantenido por deploy.sh (fase "activate") que apunta a la versión
# desplegada en /opt/vinto-mvp-web/releases/<sha> (CLOUD-DEP-02A.2, DEP55-04: versiones separadas
# para poder revertir). systemd resuelve el symlink al arrancar el servicio.
WorkingDirectory=/opt/vinto-mvp-web/current

# PORT/HOST son las dos variables que vinext lee en TIEMPO DE EJECUCIÓN (confirmado en CLOUD-01B-1:
# node_modules/vinext/README.md — HOST, no HOSTNAME, para evitar la colisión con la variable de
# entorno de Linux). NEXT_PUBLIC_API_URL NO se fija aquí: ese valor se incrusta en el bundle del
# cliente en TIEMPO DE BUILD (confirmado en CLOUD-01B-1), así que cambiarlo aquí no tendría ningún
# efecto — se fija al compilar, AHORA fuera del VPS (CLOUD-DEP-02B.1-C.1: ver
# deploy/mvp/scripts/deploy.sh, fase "install-frontend-artifact").
Environment=PORT=3100
Environment=HOST=127.0.0.1

# Runtime Node AISLADO (CLOUD-DEP-02B.1-C.1): nunca /usr/bin/node ni ningún Node instalado a
# nivel de sistema/apt — ese cambiaría el PATH global, compartido con TVC/ETL. "runtime/active" es
# un symlink mantenido por deploy.sh (fase "install-node-runtime") hacia la versión de Node
# vigente bajo /opt/vinto-mvp-web/runtime/, verificada por checksum antes de instalarse. systemd
# resuelve este symlink (y el de "current" arriba) al arrancar el servicio.
ExecStart=/opt/vinto-mvp-web/runtime/active/bin/node /opt/vinto-mvp-web/current/dist/standalone/server.js

Restart=on-failure
RestartSec=5

MemoryMax=512M
CPUQuota=100%
TasksMax=256

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/vinto-mvp-web/current/dist

[Install]
WantedBy=multi-user.target
