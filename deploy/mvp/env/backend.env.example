# VINTO MVP WEB — plantilla para /opt/vinto-mvp-web/shared/backend.env en el VPS (CLOUD-DEP-02A;
# ruta corregida en CLOUD-DEP-02A.2, DEP55-04: el .env real vive en "shared/", fuera de cualquier
# release, y deploy.sh enlaza releases/<sha>/backend/.env -> ../../../shared/backend.env).
#
# NUNCA versionar el archivo real. Copiar esta plantilla, generar contraseñas nuevas
# (p. ej. `openssl rand -base64 24`), y guardarla con permisos 600, propietario vinto-mvp:vinto-mvp
# (ver deploy/mvp/scripts/deploy.sh). Ningún valor de aquí es una contraseña real.
#
# Esta misma Settings (backend/app/config.py) la leen TANTO el proceso de la API en ejecución
# (uvicorn, vía DATABASE_URL — pg_privilege_mode NO cambia esa conexión: ver backend/app/database.py,
# siempre usa DATABASE_URL directamente) COMO las herramientas administrativas que se ejecuten a mano
# en este mismo host (migrate.py, import_reference.py — esas sí respetan pg_privilege_mode).

APP_NAME="VINTO MVP WEB"
# APP_ENV distinto de los valores "seguros para pruebas" que reconoce assert_test_admin_allowed()
# ({"local","test","qa","ci"} — ver backend/app/db_guard.py): así, si alguna vez alguien ejecutara
# por error prepare_test_db.py/ephemeral_db.py contra esta instancia en modo hardened, se rechazaría
# explícitamente por no ser un entorno de prueba reconocido (defensa en profundidad; de todas formas
# nunca se instala el rol vinto_test_admin aquí — ver Fase 3 de CLOUD-DEP-02A).
APP_ENV=pilot
# Mismo origen que el frontend (nginx sirve ambos bajo el mismo dominio): ver
# deploy/mvp/nginx/vinto-mvp.conf.template. Sustituir __DOMAIN__ por el subdominio real antes de usar.
CORS_ORIGINS='["https://__DOMAIN__"]'

# Rol aplicativo (vinto_app), el único que usa el proceso de la API en ejecución.
DATABASE_URL=postgresql://vinto_app:CHANGE_ME@127.0.0.1:6544/vinto_piloto
# Base de pruebas EXCLUSIVA de este despliegue (sufijo _test obligatorio). Solo la usan las
# suites de prueba que se ejecuten manualmente en este host, nunca el proceso de la API.
TEST_DATABASE_URL=postgresql://vinto_app:CHANGE_ME@127.0.0.1:6544/vinto_piloto_test

# Modo ENDURECIDO (CLOUD-DEP-02A, Fase 3 §5): a diferencia del contenedor efímero de pruebas
# (CLOUD-01B-2B.1, que usa "legacy"), esta instancia de piloto/producción debe usar "hardened":
# ninguna herramienta administrativa cae de vuelta a DATABASE_URL (la cuenta de la API, más
# privilegiada de lo necesario para migrar/importar) si falta una URL de identidad específica.
PG_PRIVILEGE_MODE=hardened

# Identidades separadas (CLOUD-01B-2), OBLIGATORIAS en modo hardened. Nunca "vintoadmin" (es el rol
# de TVC) ni ninguna credencial de TVC. Ver backend/roles/README.md para el aprovisionamiento.
MIGRATOR_DATABASE_URL=postgresql://vinto_migrator:CHANGE_ME@127.0.0.1:6544/vinto_piloto
MIGRATOR_TEST_DATABASE_URL=postgresql://vinto_migrator:CHANGE_ME@127.0.0.1:6544/vinto_piloto_test
REFERENCE_DATABASE_URL=postgresql://vinto_reference:CHANGE_ME@127.0.0.1:6544/vinto_piloto
REFERENCE_TEST_DATABASE_URL=postgresql://vinto_reference:CHANGE_ME@127.0.0.1:6544/vinto_piloto_test

# Rol de IDENTIDAD (MF-13-01D.3B.2), OPCIONAL: login, logout, administración de usuarios/concesiones y CLI. Déjela SIN descomentar hasta que
# backend/roles/00c y 03c estén aplicados y verificados: ausente = comportamiento anterior (todo con DATABASE_URL). Presente = esas rutas usan SOLO esta URL
# y, si falla, el servicio responde 503 sin caer a DATABASE_URL. Nunca "vintoadmin" ni credenciales de TVC. Ver docs/MF-13-01D3B2-integracion-rol-identidad.md.
#IDENTITY_DATABASE_URL=postgresql://vinto_identity:CHANGE_ME@127.0.0.1:6544/vinto_piloto
#IDENTITY_TEST_DATABASE_URL=postgresql://vinto_identity:CHANGE_ME@127.0.0.1:6544/vinto_piloto_test

# TEST_ADMIN_DATABASE_URL: deliberadamente SIN DEFINIR. El rol vinto_test_admin (CREATEDB) NUNCA se
# crea en esta instancia (CLOUD-DEP-02A, Fase 3: "No crear vinto_test_admin dentro de la instancia
# que alojará piloto/producción") — si alguna suite lo necesitara, se ejecuta contra el contenedor
# efímero local de CLOUD-01B-2B.1, nunca contra este host.

DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=2000
