# VINTO MVP WEB — plantilla para deploy/mvp/docker/.env (NUNCA versionar el archivo real).
#
# Copiar a deploy/mvp/docker/.env en el VPS durante DEP-02B y reemplazar los valores CHANGE_ME con
# contraseñas generadas al momento (p. ej. `openssl rand -base64 24`). Nunca reutilizar ninguna
# contraseña de TVC (vintoadmin) ni de ningún otro sistema.

# Rol de arranque del contenedor — equivalente al "administrador del clúster" de CLOUD-01B-2.
# Solo se usa para crear los roles de aplicación (00_create_roles.sql, 01_database_grants.sql) y
# para ejecutar las migraciones (ver backend/roles/README.md). Nunca es el rol que usa la API.
POSTGRES_BOOTSTRAP_DB=vinto_mvp_bootstrap
POSTGRES_BOOTSTRAP_USER=vinto_mvp_root
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME

# Ruta de persistencia, FUERA de /opt/vinto-web y de /home/ubuntu/vinto (las de TVC). Debe existir
# y estar vacía antes del primer arranque; propietario y permisos los fija deploy/mvp/scripts/deploy.sh.
VINTO_MVP_PGDATA_DIR=/home/vinto-mvp/pgdata
