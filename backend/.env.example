APP_NAME="VINTO API"
APP_ENV=local
CORS_ORIGINS='["http://127.0.0.1:8787"]'

# Reemplazar CHANGE_ME por la contraseña local. Codificar caracteres especiales en la URL.
DATABASE_URL=postgresql://vinto_app:CHANGE_ME@127.0.0.1:5432/vinto
# Base exclusiva de pruebas: el nombre debe terminar en _test. Ver README.
TEST_DATABASE_URL=postgresql://vinto_app:CHANGE_ME@127.0.0.1:5432/vinto_test

# Identidades opcionales del modelo de privilegios mínimos (CLOUD-01B-2). Si se omiten, migrate.py,
# import_reference.py y prepare_test_db.py siguen usando DATABASE_URL/TEST_DATABASE_URL como hasta ahora.
# Ver backend/roles/README.md para el aprovisionamiento de estos roles.
# MIGRATOR_DATABASE_URL=postgresql://vinto_migrator:CHANGE_ME@127.0.0.1:5432/vinto
# MIGRATOR_TEST_DATABASE_URL=postgresql://vinto_migrator:CHANGE_ME@127.0.0.1:5432/vinto_test
# REFERENCE_DATABASE_URL=postgresql://vinto_reference:CHANGE_ME@127.0.0.1:5432/vinto
# REFERENCE_TEST_DATABASE_URL=postgresql://vinto_reference:CHANGE_ME@127.0.0.1:5432/vinto_test
# TEST_ADMIN_DATABASE_URL=postgresql://vinto_test_admin:CHANGE_ME@127.0.0.1:5432/postgres

DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=2000
