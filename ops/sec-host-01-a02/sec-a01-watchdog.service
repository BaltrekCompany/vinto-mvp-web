# SEC-HOST-01 A0.2 - template only; NOT installed by this PR.
# Run a one-shot, stop-only watchdog against privately armed state.
[Unit]
Description=Temporary PostgreSQL connection observation stop-only watchdog
Documentation=man:systemd.service(5)
ConditionPathExists=/var/lib/sec-a01-watchdog/state.json
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/sec-a01-watchdog/watchdog.py tick
WorkingDirectory=/
UMask=0077
StateDirectory=sec-a01-watchdog
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/sec-a01-watchdog
TimeoutStartSec=120s
StandardOutput=journal
StandardError=journal
